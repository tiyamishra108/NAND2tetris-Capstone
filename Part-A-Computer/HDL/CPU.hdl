CHIP CPU {

    IN inM[16],
       instruction[16],
       reset;

    OUT outM[16],
        writeM,
        addressM[15],
        pc[15];

    PARTS:

    // A instruction detection
    Not(in=instruction[15], out=isA);

    // A Register input
    Mux16(a=instruction, b=outM,
          sel=instruction[15], out=aIn);

    // A Register load
    And(a=instruction[15], b=instruction[5],
        out=loadAFromC);

    Or(a=isA, b=loadAFromC, out=loadA);

    // A Register
    ARegister(in=aIn, load=loadA,
              out=aReg,
              out[0..14]=addressM);

    // D Register
    And(a=instruction[15], b=instruction[4],
        out=loadD);

    DRegister(in=outM, load=loadD, out=dReg);

    // ALU input selection
    Mux16(a=aReg, b=inM,
          sel=instruction[12], out=aluY);

    // ALU
    ALU(x=dReg, y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=outM,
        zr=zr,
        ng=ng);

    // Memory write
    And(a=instruction[15], b=instruction[3],
        out=writeM);

    // Jump conditions
    Not(in=ng, out=notNg);
    Not(in=zr, out=notZr);

    And(a=notNg, b=notZr, out=positive);

    And(a=instruction[0], b=positive, out=jgt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[2], b=ng, out=jlt);

    Or(a=jgt, b=jeq, out=jump1);
    Or(a=jump1, b=jlt, out=jump2);

    And(a=instruction[15], b=jump2,
        out=loadPC);

    // Program Counter
    PC(in=aReg,
       load=loadPC,
       inc=true,
       reset=reset,
       out[0..14]=pc);
}