// Nand2Tetris Capstone
// Memory.hdl

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Select RAM or I/O
    DMux(in=load, sel=address[14],
         a=loadRAM, b=loadIO);

    // RAM16K
    RAM16K(in=in, load=loadRAM,
           address=address[0..13],
           out=ramOut);

    // Select Screen or Keyboard
    DMux(in=loadIO, sel=address[13],
         a=loadScreen, b=loadKeyboard);

    // Screen
    Screen(in=in, load=loadScreen,
           address=address[0..12],
           out=screenOut);

    // Keyboard
    Keyboard(out=keyboardOut);

    // Read RAM or Screen
    Mux16(a=ramOut, b=screenOut,
          sel=address[14],
          out=ramScreenOut);

    // Read Keyboard
    And(a=address[14], b=address[13],
        out=keyboardSelect);

    Mux16(a=ramScreenOut, b=keyboardOut,
          sel=keyboardSelect,
          out=out);
}